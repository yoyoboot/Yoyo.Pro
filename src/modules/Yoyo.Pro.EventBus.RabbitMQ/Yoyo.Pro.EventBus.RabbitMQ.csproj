  </ItemGroup>
  <!-- src -->
  <ItemGroup Condition="'$(AbpRefMode)'=='src'">
    <ProjectReference Include="..\..\..\..\yoyo.abp\src\Yoyo\Yoyo.csproj" />
  </ItemGroup>


</Project>
