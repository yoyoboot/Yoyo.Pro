<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\..\abpversion.props"></Import>
  <Import Project="..\modulecommon.props"></Import>
  
  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <RootNamespace>Yoyo.Pro</RootNamespace>
    
    
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- nuget -->
  <ItemGroup Condition="'$(AbpRefMode)'=='nuget'">
    <PackageReference Include="Yoyo.Abp.AspNetCore" Version="$(AbpVersion)" />
  </ItemGroup>
  <!-- src -->
  <ItemGroup Condition="'$(AbpRefMode)'=='src'">
    <ProjectReference Include="..\..\..\..\yoyoboot.abp\src\Abp.AspNetCore\Abp.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yoyo.Pro\Yoyo.Pro.csproj" />
  </ItemGroup>
</Project>
