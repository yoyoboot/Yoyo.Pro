<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\abpversion.props"></Import>
  <PropertyGroup>
    <TargetFramework>$(DotNetVersion)</TargetFramework>
    <RootNamespace>Yoyo.Pro</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- 复制icon -->
  <ItemGroup>
    <None Include="../icon.png">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.2.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.1.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Yoyo.Pro.Application\Yoyo.Pro.Application.csproj" />
    <ProjectReference Include="..\..\src\Yoyo.Pro.EntityFrameworkCore\Yoyo.Pro.EntityFrameworkCore.csproj" />
  </ItemGroup>
  <!-- nuget -->
  <ItemGroup Condition="'$(AbpRefMode)'=='nuget'">
    <PackageReference Include="Yoyo.Abp.TestBase" Version="$(AbpVersion)" />
  </ItemGroup>
  <!-- src -->
  <ItemGroup Condition="'$(AbpRefMode)'=='src'">
    <ProjectReference Include="..\..\..\yoyoboot.abp\src\Abp.TestBase\Abp.TestBase.csproj" />
  </ItemGroup>
</Project>
